+class SkillCatalog:
+    def __init__(self):
+        self.skills = {}
+        self.loads = 0
+
+    def register(self, name, description, body):
+        self.skills[name] = (description, body)
+
+    def list(self):
+        return [{"name": name, "description": item[0]} for name, item in sorted(self.skills.items())]
+
+    def load(self, name):
+        body = self.skills[name][1]
+        self.loads += 1
+        return body
+
